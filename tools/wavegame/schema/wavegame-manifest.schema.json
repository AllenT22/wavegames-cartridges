{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavegames.local/schema/wavegame-1.json",
  "title": "Wave Games cartridge manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "title",
    "icon",
    "engineApi",
    "entrypoints",
    "orientation",
    "capabilities",
    "modes"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "engineApi": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*){2,}$",
      "maxLength": 48
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedTextLong" },
    "icon": { "type": "string", "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "ui"],
      "properties": {
        "rules": { "type": "string", "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.mjs$" },
        "ui": { "type": "string", "maxLength": 255, "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.html$" }
      }
    },
    "orientation": { "enum": ["any", "portrait", "landscape"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["audio", "storage"] }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "local": { "$ref": "#/$defs/localMode" },
        "wave": { "$ref": "#/$defs/waveMode" }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 },
      "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" }
    },
    "localizedTextLong": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 240 },
      "propertyNames": { "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" }
    },
    "localMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minPlayers", "maxPlayers"],
      "properties": {
        "minPlayers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxPlayers": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "waveMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minPlayers", "maxPlayers", "pace"],
      "properties": {
        "minPlayers": { "type": "integer", "minimum": 2, "maximum": 8 },
        "maxPlayers": { "type": "integer", "minimum": 2, "maximum": 8 },
        "pace": { "const": "turn-based" }
      }
    }
  }
}
